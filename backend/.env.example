# VANTA TRADE backend — environment variables. Copy to .env and fill in
# real values. NEVER commit an actual .env file. No private keys or seed
# phrases are ever used anywhere in this backend — deposit addresses are
# generated per-user and are watch-only.

# --- Database ----------------------------------------------------------------
DATABASE_URL=

# --- Authentication (JWT) -----------------------------------------------------
APP_SECRET_KEY=
JWT_EXPIRE_MINUTES=

# --- CORS ----------------------------------------------------------------------
ALLOWED_ORIGINS=

# --- TRON — Nile Testnet ONLY (network itself is hardcoded in config.py,
#     not env-driven, so this can never be pointed at Mainnet by accident) ---
TRON_NILE_API_BASE=
TRON_API_KEY=
USDT_TRC20_CONTRACT_NILE=
TRON_REQUIRED_CONFIRMATIONS=
DEPOSIT_POLL_INTERVAL_SECONDS=

# --- Trading (virtual balance only) -------------------------------------------
TRADE_PAYOUT_RATE=
MIN_TRADE_AMOUNT=
MAX_TRADE_AMOUNT=

# --- Demo market simulation (drives the chart + trade settlement) ------------
MARKET_TICK_INTERVAL_SECONDS=
MARKET_STARTING_PRICE=

ENVIRONMENT=
